# ── LLM Models ──────────────────────────────────────────────
# Options: groq/llama-3.3-70b-versatile | gemini-flash | claude-haiku | ollama/mistral
RESEARCH_MODEL=groq/llama-3.3-70b-versatile
ANALYSIS_MODEL=groq/llama-3.3-70b-versatile

# ── API Keys ─────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Images ───────────────────────────────────────────────────
# Tier 1: Gemini image gen (requires Google billing)
# Tier 2: HuggingFace FLUX.1-schnell — free account at huggingface.co → Settings → Access Tokens
HF_TOKEN=
# Tier 3: Pexels stock photos (free key at pexels.com/api)
PEXELS_API_KEY=

# ── Quality Control ──────────────────────────────────────────
QUALITY_THRESHOLD=7.0
MAX_RETRIES=2

# ── Telegram ─────────────────────────────────────────────────
# Get token from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Your personal chat ID — send a message to @userinfobot to get it
TELEGRAM_CHAT_ID=

# ── LinkedIn ─────────────────────────────────────────────────
# Run python auth_linkedin.py once — these get set automatically
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_USER_SUB=

# ── Instagram (instagrapi — no developer app needed) ─────────
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# ── Publishing (add later) ───────────────────────────────────
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
